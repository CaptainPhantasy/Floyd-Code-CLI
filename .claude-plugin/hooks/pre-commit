#!/usr/bin/env bash
#
# Git pre-commit hook for validating VS Code agent files
#
# Installation:
#   cp .claude-plugin/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use git config:
#   git config core.hooksPath .claude-plugin/hooks

set -e

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Validating agent files...${NC}"

# Get staged agent files
STAGED_AGENT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(agent\.md|\.claude/agents/.*\.md)$' || true)

if [ -z "$STAGED_AGENT_FILES" ]; then
  echo -e "${GREEN}✓ No agent files to validate${NC}"
  exit 0
fi

# Check if validator exists
VALIDATOR=".claude-plugin/bin/validate-agents.ts"
if [ ! -f "$VALIDATOR" ]; then
  echo -e "${YELLOW}⚠ Agent validator not found, skipping validation${NC}"
  exit 0
fi

# Validate each file
ERRORS=0
for FILE in $STAGED_AGENT_FILES; do
  if [ -f "$FILE" ]; then
    echo -e "${BLUE}  Checking ${FILE}...${NC}"
    
    if npx tsx "$VALIDATOR" check --file="$FILE" > /dev/null 2>&1; then
      echo -e "${GREEN}  ✓ ${FILE}${NC}"
    else
      echo -e "${RED}  ✗ ${FILE} - validation failed${NC}"
      
      # Show errors
      npx tsx "$VALIDATOR" check --file="$FILE" 2>&1 | grep -E "(✗|Error)" || true
      
      ERRORS=$((ERRORS + 1))
    fi
  fi
done

if [ $ERRORS -gt 0 ]; then
  echo ""
  echo -e "${RED}❌ ${ERRORS} agent file(s) failed validation${NC}"
  echo -e "${YELLOW}💡 Run: npx tsx $VALIDATOR fix --file=<path>${NC}"
  echo -e "${YELLOW}   Or bypass with: git commit --no-verify${NC}"
  exit 1
fi

echo -e "${GREEN}✓ All agent files valid${NC}"
exit 0
