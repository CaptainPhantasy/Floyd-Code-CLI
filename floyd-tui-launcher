#!/bin/bash
# Floyd Launcher - Compare Floyd TUI vs OpenCode+Floyd

set -e

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║   ${GREEN}FLOYD${CYAN} - Mode Selection               ${CYAN}║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
echo ""
echo "1) Floyd TUI (native Ink-based UI)"
echo "2) OpenCode + Floyd MCP tools"
echo "3) Floyd CLI (wrapper mode)"
echo ""

read -p "Choose [1-3]: " choice

case $choice in
  1)
    echo -e "${GREEN}Launching Floyd TUI...${NC}"
    export FLOYD_MODE="${FLOYD_MODE:-yolo}"
    exec /Volumes/Storage/FLOYD_CLI/floyd-wrapper --tui
    ;;
  2)
    echo -e "${GREEN}Launching OpenCode with Floyd tools...${NC}"
    export FLOYD_MODE="${FLOYD_MODE:-yolo}"
    cd "/Volumes/Storage/FLOYD_CLI/TUI REBUILD"
    # Load Floyd prompt via --prompt
    exec opencode --prompt "$(cat /Volumes/Storage/FLOYD_CLI/TUI\ REBUILD/.opencode/floyd.md)"
    ;;
  3)
    echo -e "${GREEN}Launching Floyd CLI wrapper...${NC}"
    export FLOYD_MODE="${FLOYD_MODE:-yolo}"
    exec /Volumes/Storage/FLOYD_CLI/floyd-wrapper
    ;;
  *)
    echo -e "${YELLOW}Invalid choice${NC}"
    exit 1
    ;;
esac
