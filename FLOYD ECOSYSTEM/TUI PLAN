  // Provider factory                                                                                                                                       
  function createFloydClient(env: Record<string, string>): FloydProvider {                                                                                  
    const baseConfig = {                                                                                                                                    
      apiKey: env.FLOYD_API_KEY,                                                                                                                            
      apiEndpoint: env.FLOYD_API_ENDPOINT,                                                                                                                  
      model: env.FLOYD_MODEL,                                                                                                                               
    };                                                                                                                                                      
                                                                                                                                                            
    switch (env.FLOYD_PROVIDER) {                                                                                                                           
      case 'glm':                                                                                                                                           
        return new GLMClient(baseConfig);                                                                                                                   
      case 'openai':                                                                                                                                        
        return new OpenAICompatible(baseConfig);                                                                                                            
      case 'anthropic':                                                                                                                                     
        return new AnthropicAdapter(baseConfig);                                                                                                            
      default:                                                                                                                                              
        return new GLMClient(baseConfig); // Default to GLM                                                                                                 
    }                                                                                                                                                       
  }                                                                                                                                                         
                                                                                                                                                            
